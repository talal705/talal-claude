# Database
# Copy to .env.local in the repository root (git-ignored). Local PostgreSQL 18 via Homebrew.
# Role ytl_app owns only these two databases. The test database is wiped by the tests.
DATABASE_URL="postgresql://ytl_app:CHANGE_ME@localhost:5432/yourtechlab"
TEST_DATABASE_URL="postgresql://ytl_app:CHANGE_ME@localhost:5432/yourtechlab_test"



# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Signs the guest session cookie. At least 32 characters, generated per install:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="CHANGE_ME_generate_with_the_command_above"


# Local compiled-language runner (start with npm run runner).
RUNNER_URL="http://127.0.0.1:4000"
# RUNNER_JAVA_HOME=""             # optional; existing Homebrew JDK25 is detected by npm run runner

# AI tutor (optional). Without AI_PROVIDER and AI_API_KEY the tutor uses its built-in rule-based hints.
# AI_PROVIDER="openai"             # owner choice; also anthropic or openai_compatible
# OPENAI_API_KEY=""                # OpenAI: server-only project API key
# AI_MODEL="gpt-6-luna"             # OpenAI default; can be changed
# AI_OPENAI_REASONING_EFFORT="low"  # OpenAI only
# AI_API_KEY=""                    # server only; never sent to the browser
# AI_MODEL=""                      # provider model id; see apps/web/lib/server/tutor for the default
# AI_EFFORT="low"
# AI_MAX_OUTPUT_TOKENS="4000"
# AI_TIMEOUT_MS="30000"
# AI_REFUSAL_FALLBACK="off"        # "on" lets a declined request retry on the provider's fallback model (beta feature)
